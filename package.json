{
  "name": "supermemory",
  "version": "0.1.0",
  "description": "Local MCP server giving AI agents structured, validated, searchable access to a git-synced Markdown knowledge vault",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "supermemory": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.1",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
