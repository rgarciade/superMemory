{
  "name": "supermemory",
  "version": "0.1.0",
  "description": "Local MCP server giving AI agents structured, validated, searchable access to a git-synced Markdown knowledge vault",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "supermemory": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
