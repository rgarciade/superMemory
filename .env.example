# supermemory environment knobs (see docs/RFC.md §8).
# Copy to `.env` for dev dogfooding in the source repo; `.env` is always gitignored.
# Values shown are the built-in defaults / empty means unset.

# Vault path override (serve --vault > this > vaults.default in global config).
SUPERMEMORY_VAULT=

# Override the config directory (defaults to ~/.config/supermemory).
SUPERMEMORY_CONFIG_DIR=

# error | warn | info | debug — all logs go to stderr (stdout is MCP protocol).
SUPERMEMORY_LOG_LEVEL=info

# Sync tunables — timing knobs only; they never disable hygiene gates
# (secrets lint, validation). Precedence: env > .memory/config.yml sync: >
# rules.md git: block > built-ins (15 min / 45 s).
SUPERMEMORY_SYNC_INTERVAL_MINUTES=
SUPERMEMORY_DEBOUNCE_SECONDS=
